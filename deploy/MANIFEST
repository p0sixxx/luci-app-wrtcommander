# FileXplorer - deployment manifest
#
# One "<source relative to runtime/>  <destination absolute path>" pair per
# line. install.sh / uninstall.sh parse this file so the file list only
# has to be maintained in one place. Lines starting with # are comments,
# blank lines are ignored.
#
# The config file is handled specially by install.sh (only installed if
# missing, never overwritten) and by uninstall.sh (only removed with
# --purge) - see deploy/install.sh and deploy/uninstall.sh.

etc/config/filexplorer                                    /etc/config/filexplorer
usr/share/rpcd/ucode/filexplorer.uc                        /usr/share/rpcd/ucode/filexplorer.uc
usr/share/rpcd/acl.d/luci-app-filexplorer.json              /usr/share/rpcd/acl.d/luci-app-filexplorer.json
usr/share/luci/menu.d/luci-app-filexplorer.json              /usr/share/luci/menu.d/luci-app-filexplorer.json
usr/lib/lua/luci/controller/filexplorer.lua                 /usr/lib/lua/luci/controller/filexplorer.lua
www/luci-static/resources/view/filexplorer.js                /www/luci-static/resources/view/filexplorer.js
www/luci-static/resources/filexplorer/filexplorer.css        /www/luci-static/resources/filexplorer/filexplorer.css
usr/lib/lua/luci/i18n/filexplorer.ru.lmo                     /usr/lib/lua/luci/i18n/filexplorer.ru.lmo
