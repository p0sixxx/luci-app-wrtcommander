# Wrt Commander - deployment manifest
#
# One "<source relative to runtime/>  <destination absolute path>" pair per
# line. install.sh / uninstall.sh parse this file so the file list only
# has to be maintained in one place. Lines starting with # are comments,
# blank lines are ignored.
#
# The config file is handled specially by install.sh (only installed if
# missing, never overwritten) and by uninstall.sh (only removed with
# --purge) - see deploy/install.sh and deploy/uninstall.sh.

etc/config/wrtcommander                                    /etc/config/wrtcommander
usr/share/rpcd/ucode/wrtcommander.uc                        /usr/share/rpcd/ucode/wrtcommander.uc
usr/share/rpcd/acl.d/luci-app-wrtcommander.json              /usr/share/rpcd/acl.d/luci-app-wrtcommander.json
usr/share/luci/menu.d/luci-app-wrtcommander.json              /usr/share/luci/menu.d/luci-app-wrtcommander.json
usr/lib/lua/luci/controller/wrtcommander.lua                 /usr/lib/lua/luci/controller/wrtcommander.lua
www/luci-static/resources/view/wrtcommander.js                /www/luci-static/resources/view/wrtcommander.js
www/luci-static/resources/wrtcommander/wrtcommander.css        /www/luci-static/resources/wrtcommander/wrtcommander.css
usr/lib/lua/luci/i18n/wrtcommander.ru.lmo                     /usr/lib/lua/luci/i18n/wrtcommander.ru.lmo
