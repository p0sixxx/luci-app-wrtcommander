{
	"luci-app-filexplorer-read": {
		"description": "FileXplorer: browse, stat, preview, search, disk usage",
		"read": {
			"ubus": {
				"luci.filexplorer": [ "list", "stat", "read", "search", "disk_info" ]
			},
			"uci": [ "filexplorer" ]
		}
	},

	"luci-app-filexplorer-write": {
		"description": "FileXplorer: create, edit, rename, copy, move",
		"write": {
			"ubus": {
				"luci.filexplorer": [ "mkdir", "create", "rename", "write", "copy", "move" ]
			}
		}
	},

	"luci-app-filexplorer-delete": {
		"description": "FileXplorer: delete files and directories",
		"write": {
			"ubus": {
				"luci.filexplorer": [ "remove" ]
			}
		}
	},

	"luci-app-filexplorer-chmod": {
		"description": "FileXplorer: change permissions",
		"write": {
			"ubus": {
				"luci.filexplorer": [ "chmod" ]
			}
		}
	},

	"luci-app-filexplorer-chown": {
		"description": "FileXplorer: change owner/group",
		"write": {
			"ubus": {
				"luci.filexplorer": [ "chown" ]
			}
		}
	},

	"luci-app-filexplorer": {
		"description": "FileXplorer: full access (menu visibility + all operations)",
		"read": {
			"ubus": {
				"luci.filexplorer": [ "list", "stat", "read", "search", "disk_info" ]
			},
			"uci": [ "filexplorer" ]
		},
		"write": {
			"ubus": {
				"luci.filexplorer": [ "mkdir", "create", "rename", "write", "copy", "move", "remove", "chmod", "chown" ]
			},
			"uci": [ "filexplorer" ]
		}
	}
}
